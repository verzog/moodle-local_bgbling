{{!
    @template local_bgbling/background

    Decorative background video layer, fixed behind the page.

    The media URL is held in data-src and only loaded by the local_bgbling/background
    AMD module, which skips it for visitors who prefer reduced motion (and, optionally,
    on small screens). Those visitors see the poster image instead.

    Context variables required for this template:
    * isnative - true for a video element (uploaded file or direct URL), false for a YouTube/Vimeo iframe
    * src - URL of the video file or iframe embed
    * posterurl - poster image URL, may be empty
    * hasoverlay - whether to draw the tint layer
    * overlaycolour - CSS colour of the tint layer
    * overlayopacity - opacity of the tint layer, 0 to 0.9
    * respectmotion - whether to hide the video for visitors who prefer reduced motion
    * hassound - whether to show the button that turns the video's sound on and off

    Example context (json):
    {
        "isnative": true,
        "src": "https://example.com/background.mp4",
        "posterurl": "https://example.com/poster.jpg",
        "hasoverlay": true,
        "overlaycolour": "#000000",
        "overlayopacity": "0.40",
        "respectmotion": true,
        "hassound": true
    }
}}
<div class="local-bgbling{{#respectmotion}} local-bgbling-respectmotion{{/respectmotion}}" aria-hidden="true"{{#posterurl}} style="background-image: url('{{posterurl}}');"{{/posterurl}}>
    {{#isnative}}
    <video class="local-bgbling-media local-bgbling-video" data-src="{{src}}"
        {{#posterurl}}poster="{{posterurl}}"{{/posterurl}} muted loop playsinline
        preload="none" tabindex="-1"></video>
    {{/isnative}}
    {{^isnative}}
    <div class="local-bgbling-frame">
        <iframe class="local-bgbling-media local-bgbling-iframe" data-src="{{src}}"
            title="{{#str}}iframetitle, local_bgbling{{/str}}" tabindex="-1"
            allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    {{/isnative}}
    {{#hasoverlay}}
    <div class="local-bgbling-overlay" style="background-color: {{overlaycolour}}; opacity: {{overlayopacity}};"></div>
    {{/hasoverlay}}
</div>
{{#hassound}}
<button type="button" class="local-bgbling-sound btn btn-dark" aria-pressed="false"
    aria-label="{{#str}}soundbutton, local_bgbling{{/str}}" title="{{#str}}soundbutton, local_bgbling{{/str}}" hidden>
    <span class="local-bgbling-sound-off">{{#pix}}soundoff, local_bgbling{{/pix}}</span>
    <span class="local-bgbling-sound-on">{{#pix}}soundon, local_bgbling{{/pix}}</span>
</button>
{{/hassound}}
